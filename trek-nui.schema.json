{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NuiSchema",
  "description": "Root configuration schema for NUI (Network User Interface) contracts.",
  "type": "object",
  "properties": {
    "endpoints": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/EndpointDefinition"
      }
    },
    "enums": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/EnumDefinition"
      }
    },
    "events": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/EventDefinition"
      }
    },
    "resource": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "resource"
  ],
  "$defs": {
    "EndpointDefinition": {
      "description": "Definition structure for two-way NUI callback endpoints.",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeDefinition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "$ref": "#/$defs/TypeDefinition"
        },
        "type": {
          "$ref": "#/$defs/EndpointType"
        }
      },
      "required": [
        "name",
        "type",
        "response"
      ]
    },
    "EndpointType": {
      "description": "Classification of RPC endpoints used to drive code generation.",
      "type": "string",
      "enum": [
        "query",
        "mutation"
      ]
    },
    "EnumDefinition": {
      "description": "Definition structure for enum types.",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    },
    "EventDefinition": {
      "description": "Definition structure for one-way UI events.",
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TypeDefinition"
        }
      },
      "required": [
        "name",
        "payload"
      ]
    },
    "TypeDefinition": {
      "description": "Polymorphic representation of payload field types.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeDefinition"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TypeDefinition"
          }
        }
      ]
    }
  }
}
